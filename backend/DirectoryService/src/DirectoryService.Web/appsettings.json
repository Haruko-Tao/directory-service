{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "UseDapperRepository": false,
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SoftDeleteCleanup": {
    "Interval": "00:01:00",
    "RetentionPeriod": "00:00:10",
    "BatchSize": 500
  }
}